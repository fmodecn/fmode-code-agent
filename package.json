{
  "name": "@fmode/skill-code-agent",
  "version": "0.1.1",
  "description": "数字人开发基础规则技能｜fmode-code-agent 规则库：纯 JS 网页版 Bot 智能体开发规范（Agent/MCP/Skill 三层 / LangGraph 无构建 / 浏览器端 MCP / token 实测 / 自动部署），把踩过的坑沉淀成硬性约束，让 AI 生成代码时不重犯同类错误。含全局技能、脚手架与规则安装器。",
  "type": "module",
  "keywords": [
    "fmode",
    "digital-human",
    "agent-rules",
    "skill",
    "claude-code",
    "claude-skill",
    "agent",
    "mcp",
    "langgraph",
    "function-calling",
    "no-build",
    "native-esm",
    "browser",
    "rules"
  ],
  "author": {
    "name": "liuyuyang",
    "email": "liu@fmode.cn"
  },
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fmodecn/fmode-code-agent.git"
  },
  "homepage": "https://github.com/fmodecn/fmode-code-agent#readme",
  "bugs": {
    "url": "https://github.com/fmodecn/fmode-code-agent/issues"
  },
  "files": [
    "skills",
    "docs",
    "examples",
    ".claude",
    "README.md",
    "CLAUDE.md",
    "LICENSE"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./skill/*": "./skills/fmode-code-agent/*",
    "./rules/*": "./.claude/rules/*"
  },
  "bin": {
    "fmode-code-agent": "skills/fmode-code-agent/scripts/install.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "smoke": "node skills/fmode-code-agent/scripts/smoke.mjs",
    "install-skill": "node skills/fmode-code-agent/scripts/install.mjs install --force",
    "install-rules": "node skills/fmode-code-agent/scripts/install-rules.mjs"
  }
}
